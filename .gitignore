# ABOUTME: Git ignore for freedom-semantic-shift research project.
# ABOUTME: Excludes secrets, large data, build artifacts, and OS files.

# Secrets
.env
*.env.*
!.env.example

# Runtime batch state (contains transient batch IDs)
**/.batch_state_*.json

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Large data directories (download separately — see README for sources)
/data/
web/data_archive/
web/data_full/
web/data_zenodo_backup/
web/web/

# Regenerable outputs. Git carries code, docs, and the small reported results
# — not bulk generated data. Every path below has a script that rebuilds it;
# see "Regenerating the data" in the README.
outputs/council/
outputs/tier2_analysis.json
outputs/tier2_fulltext_analysis.json
outputs/trends_full_history.json
outputs/trends_2020s_analysis.json
outputs/modern_embeddings.json
outputs/semantic_axis.json
outputs/neighborhood_dynamics.json
outputs/economic_freedom_analysis.json
outputs/financial_freedom_deep_dive.json
outputs/wiki_embeddings.json

# Node
web/node_modules/

# macOS
.DS_Store
**/.DS_Store
