# ABOUTME: Template for required environment variables.
# ABOUTME: Copy to .env and fill in your own values — never commit .env.

# Anthropic — Haiku classifier, prompt arena, and the council's Claude seat.
# Read by the SDK default (anthropic.Anthropic()).
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI — the council's GPT seat only. Read by the SDK default (OpenAI()).
OPENAI_API_KEY=your-openai-api-key-here

# Google AI — the council's Gemini seat only.
# GEMINI_API_KEY is accepted as a fallback.
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# Cloudflare R2 — required only for web/api/labels.js (label persistence).
# The site works read-only without them.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=freedomlabels
